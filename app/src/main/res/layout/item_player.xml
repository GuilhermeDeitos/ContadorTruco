<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de um jogador. Incluído duas vezes em activity_main (retrato e paisagem). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_nome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Truco.Name"
                tools:text="Jogador 1" />

            <TextView
                android:id="@+id/tv_vitorias"
                style="@style/Widget.Truco.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:drawableStartCompat="@drawable/ic_trophy"
                tools:text="0 vitórias" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_pontos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.Truco.Score"
            app:autoSizeMaxTextSize="120sp"
            app:autoSizeMinTextSize="40sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform"
            tools:text="7" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progresso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:max="12"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="?attr/colorSecondaryContainer"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sum1"
                style="@style/Widget.Truco.Button.Score.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/plus_1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sum3"
                style="@style/Widget.Truco.Button.Score"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/plus_3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sum6"
                style="@style/Widget.Truco.Button.Score"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/plus_6" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sum9"
                style="@style/Widget.Truco.Button.Score"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/plus_9" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sum12"
                style="@style/Widget.Truco.Button.Score"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/plus_12" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
