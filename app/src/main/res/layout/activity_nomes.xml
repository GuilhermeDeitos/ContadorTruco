<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NomesActivity">

    <TextView
        android:id="@+id/tv_nomePlayer1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/player1_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_nomeJogador1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ems="10"
        android:hint="@string/player1_hint"
        android:inputType="textPersonName"
        app:layout_constraintBottom_toBottomOf="@+id/tv_nomePlayer1"
        app:layout_constraintStart_toEndOf="@+id/tv_nomePlayer1"
        app:layout_constraintTop_toTopOf="@+id/tv_nomePlayer1" />

    <TextView
        android:id="@+id/tv_nomePlayer2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/player2_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_nomePlayer1" />

    <EditText
        android:id="@+id/et_nomeJogador2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ems="10"
        android:hint="@string/player2_hint"
        android:inputType="textPersonName"
        app:layout_constraintBottom_toBottomOf="@+id/tv_nomePlayer2"
        app:layout_constraintStart_toEndOf="@+id/tv_nomePlayer2"
        app:layout_constraintTop_toTopOf="@+id/tv_nomePlayer2" />

    <Button
        android:id="@+id/btn_confirmarNome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:text="@string/btn_confirmar"
        app:cornerRadius="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_nomeJogador2" />
</androidx.constraintlayout.widget.ConstraintLayout>