<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Formas -->
    <style name="ShapeAppearance.Truco.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.Truco.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.Truco.Action" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Texto -->
    <style name="TextAppearance.Truco.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Truco.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Truco.Name" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Truco.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Truco.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Números grandes: fonte leve e algarismos de largura fixa (não "pulam" ao mudar) -->
    <style name="TextAppearance.Truco.Score" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">120sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">300</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Truco.Wins" parent="TextAppearance.Truco.Score">
        <item name="android:textSize">88sp</item>
    </style>

    <!-- Cartão -->
    <style name="Widget.Truco.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">2dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Truco.Card</item>
    </style>

    <!-- Botões de pontos (+3, +6, +9, +12) -->
    <style name="Widget.Truco.Button.Score" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">15sp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Truco.Button</item>
    </style>

    <!-- +1: ação mais frequente, em destaque -->
    <style name="Widget.Truco.Button.Score.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <!-- Botões da barra inferior: ícone em cima, texto embaixo -->
    <style name="Widget.Truco.Button.Action" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconGravity">textTop</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Truco.Action</item>
    </style>

    <style name="Widget.Truco.Button.Action.Destructive">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="iconTint">?attr/colorPrimary</item>
    </style>

    <!-- Ações no cabeçalho (modo paisagem): ícone ao lado do texto -->
    <style name="Widget.Truco.Button.Compact" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="iconSize">20dp</item>
    </style>

    <style name="Widget.Truco.Button.Compact.Destructive">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="iconTint">?attr/colorPrimary</item>
    </style>

    <!-- Botão só com ícone (desfazer) -->
    <style name="Widget.Truco.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/truco_icon_tint</item>
    </style>

    <!-- Botão principal de tela (Confirmar) -->
    <style name="Widget.Truco.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Truco.Action</item>
    </style>

    <!-- Campo de texto -->
    <style name="ShapeAppearance.Truco.Field" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Widget.Truco.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.Truco.Field</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <!-- Barra superior das telas internas -->
    <style name="Widget.Truco.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.Truco.Toolbar</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
    </style>

    <!-- Chip informativo (não clicável) -->
    <style name="Widget.Truco.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAppearance">@style/TextAppearance.Truco.Label</item>
    </style>

    <style name="Widget.Truco.Chip.Accent">
        <item name="android:background">@drawable/bg_chip_accent</item>
        <item name="android:drawableTint">?attr/colorOnPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

</resources>
